# ==============================================================================
# Gemini Enterprise & NotebookLM SDP Governance Demo Configuration (.env)
# Copy this file to .env and update with your Google Cloud Test Project values:
#   cp .env.example .env
# ==============================================================================

# 1. Google Cloud Project Identifiers
PROJECT_ID=your-gcp-project-id
# Optional: If left empty, scripts will automatically resolve PROJECT_NUMBER via Cloud Resource Manager
PROJECT_NUMBER=

# 2. Control Plane Multi-Region / Location
# Supported values for Gemini Enterprise & NotebookLM Enterprise: global | us | eu
LOCATION=global
# Regional location for GCS Buckets, BigQuery Dataset, and Regional Model Armor if needed
BUCKET_LOCATION=us-central1
BQ_LOCATION=US

# 3. Existing Gemini Enterprise App (Engine) & Data Store Identifiers (Optional)
# Set these if you want scripts 02, 03, and 04 to inspect/bind an existing GE App & Data Store
GE_ENGINE_ID=your-ge-engine-id
GE_DATA_STORE_ID=your-gcs-datastore-id

# 4. GCS Buckets for Raw (Unmasked) vs. Masked (De-identified) Documents
# Defaults to ${PROJECT_ID}-ge-sdp-raw-docs and ${PROJECT_ID}-ge-sdp-masked-docs if left blank
RAW_BUCKET_NAME=
MASKED_BUCKET_NAME=

# 5. BigQuery Audit Log Destination for SDP Content Policy (ContentPolicyActionLog)
BQ_DATASET_ID=sdp_audit_logs
BQ_TABLE_ID=content_policy_action_logs

# 6. SDP Content Policy & Model Armor Resource IDs
SDP_POLICY_ID=ge-notebooklm-sdp-policy
DLP_INSPECT_TEMPLATE_ID=ge-notebooklm-inspect-tmpl
DLP_DEIDENTIFY_TEMPLATE_ID=ge-notebooklm-deid-tmpl
MODEL_ARMOR_TEMPLATE_ID=ge-notebooklm-armor-tmpl

# 7. Enforcement Behavior
# Options for Fallback Action when file exceeds inspection size limit: BLOCK | ALLOW
SDP_FALLBACK_ACTION=BLOCK
# Wait for 10-minute NotebookLM CustomerConfigurationCache TTL countdown after binding (true | false)
WAIT_FOR_CACHE_TTL=false
